{
    "name": "armm/framework",
    "description": "Agile REST Micro Module — a lightweight PHP framework for building REST APIs.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "ARMM\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ARMM\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
